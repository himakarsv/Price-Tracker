<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Price Tracker</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f3f4f6; padding: 24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden;">
            <tr>
              <td style="background-color: #1a1a2e; padding: 32px 24px; text-align: center;">
                <h1 style="margin: 0; color: #ffffff; font-size: 24px;">Price Tracker</h1>
                <p style="margin: 8px 0 0; color: #c7c7d9; font-size: 14px;">Smart price tracking, simplified</p>
              </td>
            </tr>

            <tr>
              <td style="padding: 32px 24px;">
                <h2 style="margin: 0 0 16px; font-size: 22px; color: #1a1a2e; text-align: center;">Welcome to Price Tracker, {{userName}}!</h2>
                <p style="margin: 0 0 24px; font-size: 15px; color: #4b5563; line-height: 1.6; text-align: center;">
                  Track prices across Amazon, Flipkart, and Myntra, and get alerted the moment a price drops to your target. Add the products you love and let us watch the prices for you.
                </p>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center">
                      <a href="{{dashboardUrl}}" style="display: inline-block; background-color: #1a1a2e; color: #ffffff; text-decoration: none; padding: 14px 36px; border-radius: 6px; font-size: 16px; font-weight: bold;">Get Started</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 24px; border-top: 1px solid #e5e7eb;">
                <p style="margin: 0; font-size: 12px; color: #9ca3af; text-align: center; line-height: 1.5;">You're receiving this because you signed up for Price Tracker.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
